# ---------------------------------------------------------------------------
# Career Engine -- backend environment
#
# Copy this file to `.env` and fill in what you need.
# EVERY value here is OPTIONAL: with an empty .env the application still runs,
# using unauthenticated GitHub access. No API keys are required, and no
# language model is used anywhere in this project.
# ---------------------------------------------------------------------------

# Optional. A GitHub personal access token (no scopes needed for public data).
# Raises the REST API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- RAG settings (sensible defaults; override only if you need to) ---------
# Local sentence-transformers model used to embed job-description chunks.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to 1 to skip the model download and use the offline TF-IDF+SVD backend.
FORCE_OFFLINE_EMBEDDINGS=0
RAG_TOP_K=8
RAG_DERIVATION_TOP_K=24
CHUNK_MAX_WORDS=70
CHUNK_OVERLAP_WORDS=15

# --- Frontend origin allowed by CORS ---------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
